{
  "name": "@arbol-ai/maximus",
  "version": "8.0.0",
  "description": "Maximus: define a service once and serve it over HTTP, MCP and Worker RPC on Cloudflare Workers, configured in vite.config.ts, with its OpenAPI and CLI.",
  "keywords": [
    "api",
    "cloudflare",
    "cloudflare-workers",
    "framework",
    "mcp",
    "model-context-protocol",
    "multi-tenant",
    "openapi",
    "rpc",
    "typebox",
    "vite",
    "vite-plugin",
    "vite-plus"
  ],
  "homepage": "https://github.com/getarbol/maximus#readme",
  "bugs": {
    "url": "https://github.com/getarbol/maximus/issues"
  },
  "license": "MIT",
  "author": "Arbol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getarbol/maximus.git",
    "directory": "packages/maximus"
  },
  "bin": {
    "maximus": "bin/maximus.js"
  },
  "files": [
    "bin",
    "dist",
    "config",
    "templates",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./failures": {
      "types": "./dist/standard-failures.d.ts",
      "import": "./dist/standard-failures.js"
    },
    "./body": {
      "types": "./dist/body.d.ts",
      "import": "./dist/body.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./http-paths": {
      "types": "./dist/http-paths.d.ts",
      "import": "./dist/http-paths.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "import": "./dist/internals.js"
    },
    "./workers": {
      "types": "./dist/workers/runtime.d.ts",
      "import": "./dist/workers/runtime.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/analytics.d.ts",
      "import": "./dist/analytics/analytics.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./testing": {
      "types": "./dist/tooling/testing.d.ts",
      "import": "./dist/tooling/testing.js"
    },
    "./oxfmt": {
      "types": "./config/oxfmt.d.mts",
      "import": "./config/oxfmt.mjs"
    },
    "./oxlint": {
      "types": "./config/oxlint.d.mts",
      "import": "./config/oxlint.mjs"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "import": "./dist/project/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./config": {
      "types": "./dist/project/config.d.ts",
      "import": "./dist/project/config.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@sinclair/typebox": "0.34.52",
    "ajv-formats": "3.0.1",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "cf": "1.0.0-beta.23",
    "miniflare": "5.20261023.0-beta",
    "pg": "8.23.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": ">=2.0.0-beta.v.5",
    "cf": ">=1.0.0-beta.23",
    "oxfmt": ">=0.71.0 <1",
    "oxlint": "^1.86.0",
    "pg": "^8.23.1",
    "ultracite": "^8.1.0",
    "vite": "^8.3.4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vite-plugin": {
      "optional": true
    },
    "cf": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "ultracite": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
