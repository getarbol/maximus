import { defineHandler, t } from '@arbol-ai/maximus';

/**
 * POST /api/v1/greeting, the operation createGreeting: a greeting for the name the caller sends. A POST that
 * stores nothing declares the read effect, and so needs the read scope, __PROJECT_NAME__:greeting:read.
 */
export default defineHandler(({ input }) => ({ message: `Hello, ${input.name}` }), {
  description: 'Create a greeting for the name the caller sends, without storing anything.',
  effect: 'read',
  input: { name: t.String({ minLength: 1, maxLength: 100 }) },
  output: { message: t.String() },
});
