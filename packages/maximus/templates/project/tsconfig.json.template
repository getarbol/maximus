{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "routes",
    "pages",
    "middleware",
    "crons",
    "queues",
    "email",
    "durable-objects",
    "db",
    "maximus.config.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    ".maximus/*.ts",
    ".cloudflare/types"
  ]
}
