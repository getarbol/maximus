{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node", "@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "routes",
    "mcp",
    "pages",
    "middleware",
    "crons",
    "queues",
    "email",
    "durable-objects",
    "tests",
    "errors.ts",
    "auth.ts",
    "context.ts",
    "telemetry.ts",
    "vite.config.ts",
    ".maximus/*.ts"
  ]
}
