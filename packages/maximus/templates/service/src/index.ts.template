/**
 * The service's Worker: its fetch handler and its RPC entrypoint.
 */
import { createWorker } from '@arbol-ai/maximus/workers';

import { app } from './app';

/** The application as a Worker. */
const worker = createWorker(app);

/** The named RPC entrypoint other Workers bind to; its methods are the operations that declare `rpc`. */
export const __ENTRYPOINT__ = worker.entrypoint;
export default worker.handler;
