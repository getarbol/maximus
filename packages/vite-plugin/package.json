{
  "name": "@arbol-ai/vite-plugin",
  "version": "8.0.0",
  "description": "Maximus for Vite+: one vite.config.ts configures the application and the Cloudflare Worker that serves it.",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "maximus",
    "mcp",
    "openapi",
    "vite",
    "vite-plugin",
    "vite-plus"
  ],
  "homepage": "https://github.com/getarbol/maximus#readme",
  "bugs": {
    "url": "https://github.com/getarbol/maximus/issues"
  },
  "license": "MIT",
  "author": "Arbol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getarbol/maximus.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vp pack"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5"
  },
  "devDependencies": {
    "@arbol-ai/maximus": "workspace:^",
    "cf": "1.0.0-beta.23",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "@arbol-ai/maximus": "8.0.0",
    "cf": ">=1.0.0-beta.23",
    "vite": "^8.3.4"
  }
}
