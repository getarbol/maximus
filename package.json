{
  "name": "maximus-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/worker-rpc/*"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-package.mjs && vp run -r build",
    "typecheck": "vp run -r typecheck",
    "test": "vp test run --project unit --project examples",
    "check": "vp run typecheck && vp check",
    "fix": "vp check --fix",
    "verify": "bun run build && bun run check",
    "verify:release": "bun run verify",
    "verify:tests": "bun run test && node scripts/verify-package.mjs",
    "test:coverage": "vp test run --project unit --coverage",
    "test:integration": "vp test run --project postgres"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.4.4"
}
