  "info": {
    "title": "Pricing",
    "version": "0.0.0",
    "description": "The operations Pricing serves over native RPC, to the Workers its rpc.callers name, through a Service Binding to its Service entrypoint. No HTTP route answers these paths: each names a method, called with the caller's principal and the operation's whole input."
  },
  "tags": [
    {
      "name": "Quotes",
      "description": "Quotes of catalog items, in US cents."
    }
