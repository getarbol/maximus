{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "routes",
    "mcp",
    "src",
    "errors.ts",
    "maximus.config.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    ".maximus/*.ts",
    ".cloudflare/types"
  ]
}
